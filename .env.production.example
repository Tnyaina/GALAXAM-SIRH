# Copier en .env.production, ou laisser install.ps1 generer les secrets.
# Ne jamais partager .env.production ni le remplacer lors d'une mise a jour.
GALAXAM_DB_PASSWORD=
# Au moins 64 octets apres decodage Base64 si applicable ; utiliser la generation automatique.
GALAXAM_JWT_SECRET=
GALAXAM_WEB_PORT=8088
GALAXAM_CORS_ORIGIN=http://localhost:8088,http://127.0.0.1:8088
GALAXAM_RELEASE=prod
# Uniquement pour la premiere creation de l'administrateur.
GALAXAM_PROD_BOOTSTRAP_ADMIN_ENABLED=false
GALAXAM_DEFAULT_ADMIN_NAME=Administrateur GALAXAM
GALAXAM_DEFAULT_ADMIN_EMAIL=
GALAXAM_DEFAULT_ADMIN_PASSWORD=
# Identites persistantes : ne pas changer sur une installation existante.
GALAXAM_PROJECT_NAME=galaxam-sirh-prod
GALAXAM_PG_VOLUME=galaxam_prod_pg_data
GALAXAM_FILES_VOLUME=galaxam_prod_business_files

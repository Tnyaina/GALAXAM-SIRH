#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${1:-}" = "-f" ] || [ "${1:-}" = "--file" ]; then
  exec docker compose --project-directory "$root" "$@"
fi
exec docker compose --project-directory "$root" --env-file "$root/.env.production" -f "$root/docker-compose.yml" "$@"

#!/bin/sh
# Usage: ./scripts/compose prod|dev [up|stop|ps|logs|config|build]
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mode=${1:?Indiquer prod ou dev}
action=${2:-up}
case "$mode" in
  prod)
    file="$root/docker-compose.web.yml"
    required='SIRH_PROD_DB_PASSWORD SIRH_PROD_JWT_SECRET SIRH_ADMIN_NAME SIRH_ADMIN_EMAIL SIRH_ADMIN_PASSWORD SIRH_PROD_WEB_PORT SIRH_PROD_CORS_ORIGIN SIRH_PROD_BOOTSTRAP_ADMIN_ENABLED'
    ;;
  dev)
    file="$root/docker-compose.dev.yml"
    required='SIRH_DEV_DB_PASSWORD SIRH_DEV_JWT_SECRET SIRH_ADMIN_NAME SIRH_ADMIN_EMAIL SIRH_ADMIN_PASSWORD SIRH_DEV_WEB_PORT SIRH_DEV_BOOTSTRAP_ADMIN_ENABLED'
    ;;
  *) echo 'Mode attendu : prod ou dev' >&2; exit 2 ;;
esac
for name in $required; do
  printenv "$name" >/dev/null || { echo "Variable utilisateur absente : $name" >&2; exit 1; }
done
case "$action" in
  up)
    if [ "$mode" = dev ]; then
      docker compose --project-directory "$root" -f "$file" stop frontend backend
      docker compose --project-directory "$root" -f "$file" up -d --wait postgres
      docker compose --project-directory "$root" -f "$file" run --rm --no-deps migrate
    fi
    exec docker compose --project-directory "$root" -f "$file" up -d --build --wait
    ;;
  stop|ps|logs|build) exec docker compose --project-directory "$root" -f "$file" "$action" ;;
  config) exec docker compose --project-directory "$root" -f "$file" config --quiet ;;
  *) echo 'Action attendue : up, stop, ps, logs, config ou build' >&2; exit 2 ;;
esac

# Exemple pour l'installation locale neuve. Ne pas réutiliser les secrets du mode développement.
# Copier en .env puis renseigner des valeurs propres à l'installation.
GALAXAM_DB_PASSWORD=
GALAXAM_JWT_SECRET=
# Origine web locale ; en production, remplacer par l'origine HTTPS publique.
GALAXAM_CORS_ORIGIN=http://localhost:8088

# Utilisé uniquement par docker-compose.prod.yml. Rester à false après le bootstrap initial.
GALAXAM_PROD_BOOTSTRAP_ADMIN_ENABLED=false

# Premier compte administrateur. Secret JWT : au moins 64 octets aléatoires.
GALAXAM_BOOTSTRAP_ADMIN_ENABLED=true
GALAXAM_DEFAULT_ADMIN_NAME=Administrateur GALAXAM
GALAXAM_DEFAULT_ADMIN_EMAIL=admin@galaxam.local
# Au moins 8 caractères, avec majuscule, minuscule et chiffre.
GALAXAM_DEFAULT_ADMIN_PASSWORD=
